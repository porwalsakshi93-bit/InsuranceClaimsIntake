{
  "version": "v1",
  "hooks": [
    {
      "name": "Run Tests on Python File Save",
      "trigger": "PostFileSave",
      "description": "Automatically runs pytest whenever a .py file is saved, giving instant feedback.",
      "matcher": "\\.py$",
      "action": {
        "type": "command",
        "command": "cd \"c:\\Users\\sgupta59\\OneDrive - Aegon\\InsuranceClaimsIntake\\PythonClaimsIntake\" && python -m pytest --tb=short -q 2>&1 | tail -20",
        "timeout": 60
      }
    }
  ]
}